{
  "workspace": [
    "./packages/zenpre",
    "./server",
    "./client",
    "./bundler"
  ],
  "tasks": {
    "dev": "deno task --cwd server dev",
    "build": "deno task --cwd bundler build",
    "test": "deno test -P",
    "check": "deno check && deno lint && deno fmt --check",
    "lint": "deno fmt && deno lint && deno check"
  },
  "permissions": {
    "default": {}
  },
  "test": {
    "permissions": {
      "env": true,
      "net": ["localhost", "127.0.0.1", "0.0.0.0"],
      "read": ["./AGENTS.md"]
    }
  },
  "imports": {
    "daisyui": "npm:daisyui@^5.7.50",
    "tailwindcss": "npm:tailwindcss@^4.3.4",
    "@tailwindcss/typography": "npm:@tailwindcss/typography@^0.5.16"
  },
  "nodeModulesDir": "auto",
  "unstable": ["bundle", "kv"],
  "exclude": ["examples/", "bundled/"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@remix-run/component"
  }
}
