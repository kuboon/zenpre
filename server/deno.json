{
  "tasks": {
    "bundle": "deno task --cwd ../bundler build",
    "dev": "deno task bundle && deno serve -P --watch ./main.ts",
    "serve": "deno serve -P ./main.ts"
  },
  "compilerOptions": {
    "lib": ["deno.ns", "deno.unstable", "dom", "esnext"],
    "jsx": "react-jsx",
    "jsxImportSource": "@remix-run/component"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@kuboon/kv": "jsr:@kuboon/kv@^0.4.0",
    "arktype": "npm:arktype@^2.2.9",
    "@remix-run/component": "npm:@remix-run/component@^1.1.0",
    "@remix-run/fetch-router": "npm:@remix-run/fetch-router@^1.0.0",
    "@remix-run/response": "npm:@remix-run/response@^1.0.1",
    "@remix-run/static-middleware": "npm:@remix-run/static-middleware@^1.0.1"
  },
  "permissions": {
    "default": {
      "env": true,
      "net": ["localhost", "127.0.0.1", "0.0.0.0"],
      "read": true,
      "write": true
    }
  }
}
